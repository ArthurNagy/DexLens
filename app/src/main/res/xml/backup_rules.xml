<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing is backed up. allowBackup is false; these rules are only read on older Android versions. -->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
